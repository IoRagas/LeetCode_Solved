class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans(n, -1);
        stack<int> table; table.push(0);
        for(int i = 1; i < n ; i++)
        {
            while(!table.empty() && nums[i] > nums[table.top()]){
                ans[table.top()] = nums[i];
                table.pop();
            }
            table.push(i);
        }
        for(int i = 0; i < n; i++)
        {
            while(!table.empty() && i < table.top() && nums[i] > nums[table.top()] )
            {
                ans[table.top()] = nums[i];
                table.pop();
            }
        }
       // for(auto &v : ans)
          //  cout<<v<< " ";
        return ans;
    }
};
