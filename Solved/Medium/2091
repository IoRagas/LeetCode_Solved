//I mean there are only 3 ways of removal so too easy ig...
class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
        int x = 0, y = 0, n = nums.size();
        if(n <= 2)  return n;
        int ans = n; int big = INT_MIN, small = INT_MAX;
        for(int i = 0 ; i < n ; i++)
        {
            if(big < nums[i]){
                x = i;
                big = nums[i];
            }
            if(small > nums[i])
            {
                y = i;
                small = nums[i];
            }
        }
        if(x > y) swap(x , y);
        ans = min(ans, y + 1 );
        ans = min(ans , n - x );
        ans = min(ans, (n - y ) + (x + 1));
        return ans;
    }
};
