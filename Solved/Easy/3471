//Let's ignore the If conditions at the end.......:)
class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        int first = nums[0], last = nums[n-1];
        int fq = 0, fq2 = 0;
        int largest = INT_MIN;
        if(k == n){
            //Find the largest one
            for(int i = 0; i < n; i++)
                largest = max(largest, nums[i]);
            return largest;
        }
        unordered_map<int, int> freq;
        for(auto &v : nums) freq[v]++;
        if(k == 1)
        {
            int ans = -1;
            for(auto &v : freq){
                if(v.second == 1 && v.first > ans)
                    ans = v.first;
            }
            return ans;
        }
        if(n == 1) return nums[0];
        if(nums[0] == nums[n-1]) return -1;
        if(freq[nums[0]] != 1 && freq[nums[n-1]] != 1) return -1;
        if(freq[nums[0]] == 1 && freq[nums[n-1]] == 1) return max(nums[0], nums[n-1]);
        if(freq[nums[0]] == 1) return nums[0];
        if(freq[nums[n-1]] == 1) return nums[n-1];
        return -1;
    }
};
