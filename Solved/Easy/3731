class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        set<int> table;
        int s = INT_MAX, y = INT_MIN;
        for(auto &v : nums)
        {
            s = min(s, v);
            y = max(y, v);
            table.insert(v);
        }
        vector<int> ans;
        for(int i = s; i < y; i++)
        {
            if( table.find(i) == table.end())
            {
                ans.push_back(i);
            }
        }
        return ans;
    }
};
